@page "/mentor/meetings"
@using Microsoft.EntityFrameworkCore
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Mentor")]
@inject ApplicationDbContext Db
@inject CurrentMentorService CurrentMentor
@inject BookingService Bookings

<PageTitle>My meetings</PageTitle>

<h1>My upcoming meetings</h1>

@if (_mentor is null)
{
    <div class="alert alert-warning">No mentor profile is linked to your account.</div>
}
else
{
    <p class="text-muted">Your upcoming pending &amp; confirmed sessions, from now onward.</p>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info">@_message</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th role="button" @onclick="() => Sort(MeetingSort.Date)">
                    Date / time @SortIcon(_sort == MeetingSort.Date)
                </th>
                <th role="button" @onclick="() => Sort(MeetingSort.Student)">
                    Regular user @SortIcon(_sort == MeetingSort.Student)
                </th>
                <th role="button" @onclick="() => Sort(MeetingSort.Topic)">
                    Topic @SortIcon(_sort == MeetingSort.Topic)
                </th>
                <th>Status</th>
                <th>Meeting</th>
                <th style="width:260px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in SortedRows)
            {
                <tr>
                    <td>@m.StartUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@m.StudentName<br /><span class="small text-muted">@m.StudentEmail</span></td>
                    <td>@m.TopicName</td>
                    <td><span class="badge bg-secondary">@m.Status</span></td>
                    <td>
                        @if (m.MeetingUrl is not null)
                        {
                            <a href="@m.MeetingUrl" target="_blank">Join</a>
                        }
                    </td>
                    <td>
                        @if (_cancellingId == m.BookingId)
                        {
                            <textarea class="form-control form-control-sm mb-1" rows="2" @bind="_cancelReason"
                                      placeholder="Reason for cancellation"></textarea>
                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmCancel(m.BookingId)">Confirm</button>
                            <button class="btn btn-sm btn-link" @onclick="() => _cancellingId = null">Back</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => StartCancel(m.BookingId)">Cancel meeting</button>
                        }
                    </td>
                </tr>
            }
            @if (_rows.Count == 0)
            {
                <tr><td colspan="6" class="text-muted">You have no upcoming meetings.</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private enum MeetingSort { Date, Student, Topic }

    private Models.Mentor? _mentor;
    private List<MeetingRow> _rows = new();
    private MeetingSort _sort = MeetingSort.Date;
    private bool _asc = true;

    private int? _cancellingId;
    private string _cancelReason = string.Empty;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _mentor = await CurrentMentor.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_mentor is null) return;
        var nowUtc = DateTime.UtcNow;

        var bookings = await Db.Bookings
            .Include(b => b.Topic)
            .Where(b => b.MentorId == _mentor.Id
                        && b.StartUtc >= nowUtc
                        && (b.Status == BookingStatus.Pending || b.Status == BookingStatus.Confirmed))
            .ToListAsync();

        _rows = bookings.Select(b => new MeetingRow
        {
            BookingId = b.Id,
            StartUtc = b.StartUtc,
            StudentName = b.StudentName,
            StudentEmail = b.StudentEmail,
            TopicName = b.Topic.Name,
            Status = b.Status.ToString(),
            MeetingUrl = b.MeetingUrl
        }).ToList();
    }

    private void StartCancel(int bookingId)
    {
        _cancellingId = bookingId;
        _cancelReason = string.Empty;
    }

    private async Task ConfirmCancel(int bookingId)
    {
        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            _message = "A cancellation reason is required.";
            return;
        }

        // Ownership guard: only cancel meetings that belong to this mentor.
        if (!_rows.Any(r => r.BookingId == bookingId))
        {
            _message = "You can only cancel your own meetings.";
            return;
        }

        var result = await Bookings.CancelAsync(bookingId, _cancelReason);
        if (result.Success)
        {
            _message = "Meeting cancelled. The student was emailed with your reason.";
            _cancellingId = null;
        }
        else
        {
            _message = result.Error;
        }
        await LoadAsync();
    }

    private IEnumerable<MeetingRow> SortedRows
    {
        get
        {
            IEnumerable<MeetingRow> q = _sort switch
            {
                MeetingSort.Student => _rows.OrderBy(r => r.StudentName).ThenBy(r => r.StartUtc),
                MeetingSort.Topic => _rows.OrderBy(r => r.TopicName).ThenBy(r => r.StartUtc),
                _ => _rows.OrderBy(r => r.StartUtc)
            };
            return _asc ? q : q.Reverse();
        }
    }

    private void Sort(MeetingSort sort)
    {
        if (_sort == sort) _asc = !_asc;
        else { _sort = sort; _asc = true; }
    }

    private static MarkupString SortIcon(bool active)
    {
        return active ? (MarkupString)"<span class=\"text-muted\">&#8645;</span>" : (MarkupString)"";
    }

    private class MeetingRow
    {
        public int BookingId { get; set; }
        public DateTime StartUtc { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public string StudentEmail { get; set; } = string.Empty;
        public string TopicName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string? MeetingUrl { get; set; }
    }
}
