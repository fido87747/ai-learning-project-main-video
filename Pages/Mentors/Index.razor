@page "/mentors"
@inject MentorProfileService Profiles

<PageTitle>Mentors</PageTitle>

<h1>Mentors</h1>
<p class="text-muted">Browse our mentors and the videos they share.</p>

@if (_mentors is null)
{
    <p><em>Loading…</em></p>
}
else if (!_mentors.Any())
{
    <p class="text-muted">No mentors to show yet.</p>
}
else
{
    <div class="row g-3">
        @foreach (var m in _mentors)
        {
            var count = _videoCounts.TryGetValue(m.Id, out var c) ? c : 0;
            <div class="col-md-6 col-lg-4">
                <a class="text-decoration-none text-reset" href="@($"mentors/{m.Id}")">
                    <div class="card h-100">
                        <div class="card-body d-flex gap-3">
                            <img src="@($"/mentors/{m.Id}/photo")" alt="@m.DisplayName"
                                 class="rounded-circle flex-shrink-0"
                                 style="width:64px;height:64px;object-fit:cover;"
                                 onerror="this.onerror=null;this.src='/img/default-avatar.svg';" />
                            <div>
                                <h5 class="card-title mb-1">@m.DisplayName</h5>
                                <div class="mb-1">
                                    @foreach (var name in m.MentorTopics.Select(mt => mt.Topic.Name).OrderBy(n => n))
                                    {
                                        <span class="badge bg-secondary me-1 mb-1">@name</span>
                                    }
                                </div>
                                <small class="text-muted">
                                    @count @(count == 1 ? "video" : "videos")
                                </small>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@code {
    private List<Models.Mentor>? _mentors;
    private Dictionary<int, int> _videoCounts = new();

    protected override async Task OnInitializedAsync()
    {
        _mentors = await Profiles.GetPublicMentorsAsync(includeWithoutVideos: true);
        _videoCounts = await Profiles.GetVideoCountsAsync();
    }
}
