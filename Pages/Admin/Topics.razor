@page "/admin/topics"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject MentorManagementService Mgmt

<PageTitle>Manage topics</PageTitle>

<h1>Manage topics</h1>
<p class="text-muted">Topics are the subjects students choose from and mentors are skilled in.</p>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info">@_message</div>
}

<div class="card mb-3" style="max-width:480px;">
    <div class="card-body">
        <h5 class="card-title">Add a topic</h5>
        <div class="input-group">
            <input class="form-control" placeholder="e.g. Computer Science" @bind="_newTopic" />
            <button class="btn btn-primary" @onclick="Add">Add</button>
        </div>
    </div>
</div>

<table class="table" style="max-width:480px;">
    <thead><tr><th>Topic</th><th></th></tr></thead>
    <tbody>
        @foreach (var t in _topics)
        {
            <tr>
                <td>@t.Name</td>
                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => Remove(t.Id)">Remove</button></td>
            </tr>
        }
        @if (_topics.Count == 0)
        {
            <tr><td colspan="2" class="text-muted">No topics yet.</td></tr>
        }
    </tbody>
</table>

@code {
    private List<Topic> _topics = new();
    private string _newTopic = string.Empty;
    private string? _message;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _topics = await Mgmt.GetTopicsAsync();

    private async Task Add()
    {
        var result = await Mgmt.AddTopicAsync(_newTopic);
        _message = result.Success ? "Topic added." : result.Error;
        if (result.Success) _newTopic = string.Empty;
        await Load();
    }

    private async Task Remove(int id)
    {
        var result = await Mgmt.DeleteTopicAsync(id);
        _message = result.Success ? "Topic removed." : result.Error;
        await Load();
    }
}
