@page
@model MentorBooking.Pages.Account.ChangePasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change password - Mentor Booking</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container" style="max-width:440px;margin-top:80px;">
        <h2 class="mb-3">Change password</h2>
        <p class="text-muted">Signed in as @Model.CurrentEmail</p>

        @if (Model.Succeeded)
        {
            <div class="alert alert-success">Your password has been changed.</div>
        }

        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label class="form-label">Current password</label>
                <input asp-for="Input.CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">New password</label>
                <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm new password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Change password</button>
        </form>
        <p class="small text-muted mt-3">Password must be at least 8 characters and include a non-alphanumeric character.</p>
        <hr />
        <a class="btn btn-link" href="/">Back to home</a>
    </div>
</body>
</html>
