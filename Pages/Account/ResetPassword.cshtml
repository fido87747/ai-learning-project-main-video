@page
@model MentorBooking.Pages.Account.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset password - Mentor Booking</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container" style="max-width:440px;margin-top:80px;">
        <h2 class="mb-3">Reset password</h2>

        @if (Model.Succeeded)
        {
            <div class="alert alert-success">Your password has been reset.</div>
            <a class="btn btn-primary" href="/Account/Login">Sign in</a>
        }
        else if (Model.InvalidLink)
        {
            <div class="alert alert-danger">This reset link is invalid or has expired. Please request a new one.</div>
            <a class="btn btn-link" href="/Account/ForgotPassword">Request a new link</a>
        }
        else
        {
            <p class="text-muted">Choose a new password for <strong>@Model.Input.Email</strong>.</p>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Token" />
                <div class="mb-3">
                    <label class="form-label">New password</label>
                    <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm new password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Reset password</button>
            </form>
            <p class="small text-muted mt-3">Password must be at least 8 characters and include a non-alphanumeric character.</p>
            <hr />
            <a class="btn btn-link" href="/Account/Login">Back to sign in</a>
        }
    </div>
</body>
</html>
