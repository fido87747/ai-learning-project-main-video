@page
@model MentorBooking.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot password - Mentor Booking</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container" style="max-width:520px;margin-top:80px;">
        <h2 class="mb-3">Forgot your password?</h2>
        <p class="text-muted">Enter your account email and we'll generate a password reset link.</p>

        @if (Model.LinkGenerated)
        {
            <div class="alert alert-success">
                <p class="mb-2">A password reset link has been generated for <strong>@Model.Input.Email</strong>.</p>
                <a class="btn btn-primary btn-sm" href="@Model.ResetUrl">Reset your password</a>
            </div>
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Password reset email</span>
                    <span class="small text-muted">Email is simulated in this prototype</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted">This is the message we would email you. Click inside and select the text to copy it.</p>
                    <textarea class="form-control" rows="10" readonly style="font-family:inherit;">@Model.EmailBody</textarea>
                </div>
            </div>
            <a class="btn btn-link" href="/Account/Login">Back to sign in</a>
        }
        else
        {
            @if (Model.AccountNotFound)
            {
                <div class="alert alert-warning">No account was found with that email address.</div>
            }
            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Generate reset link</button>
            </form>
            <hr />
            <a class="btn btn-link" href="/Account/Login">Back to sign in</a>
            <a class="btn btn-link" href="/">Back to home</a>
        }
    </div>
</body>
</html>
